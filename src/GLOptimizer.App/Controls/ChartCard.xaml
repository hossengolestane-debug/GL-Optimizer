<UserControl x:Class="GLOptimizer.App.Controls.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">
  <Border Style="{StaticResource Card}" MinHeight="240">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Text.Section}" />
        <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Row="1" Margin="0,20,0,0" Background="{StaticResource Brush.Surface.2}" CornerRadius="8" MinHeight="140">
        <TextBlock Text="{Binding EmptyMessage, ElementName=Root}"
                   Style="{StaticResource Text.Subtitle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Margin="24"
                   Visibility="{Binding HasData, ElementName=Root, Converter={StaticResource InverseBoolToVis}}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
