<UserControl x:Class="GLOptimizer.App.Controls.SettingsRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">
  <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="220" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="14" />
        <TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <ContentPresenter Grid.Column="1" Content="{Binding Slot, ElementName=Root}" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
