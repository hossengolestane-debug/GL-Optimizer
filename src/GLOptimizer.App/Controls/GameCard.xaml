<UserControl x:Class="GLOptimizer.App.Controls.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GLOptimizer.App.Controls"
             x:Name="Root"
             Background="Transparent">
  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource Brush.Surface.3}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
        <TextBlock Text="{Binding Monogram, ElementName=Root}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0,0,0">
        <Grid>
          <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,120,0" />
          <controls:StatusBadge HorizontalAlignment="Right" VerticalAlignment="Center"
                                Text="{Binding StatusText, ElementName=Root}"
                                Kind="{Binding Kind, ElementName=Root}" />
        </Grid>
        <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding Detail, ElementName=Root}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
