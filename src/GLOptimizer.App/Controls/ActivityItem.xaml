<UserControl x:Class="GLOptimizer.App.Controls.ActivityItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">
  <Grid Margin="0,0,0,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="72" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Time, ElementName=Root}" Style="{StaticResource Text.Caption}" />
    <StackPanel Grid.Column="1">
      <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="13" />
      <TextBlock Text="{Binding Detail, ElementName=Root}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
