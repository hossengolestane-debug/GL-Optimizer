<views:PageView x:Class="GLOptimizer.App.Views.Pages.OptimizeView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                xmlns:controls="clr-namespace:GLOptimizer.App.Controls"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,20" />
      <controls:ProgressPanel Title="{Binding PanelTitle}" Message="{Binding PanelMessage}" Progress="{Binding Progress}" />
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Actions" Style="{StaticResource Text.Section}" />
          <TextBlock Text="{Binding ActionsMessage}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,16" />
          <Button Content="Run selected action" HorizontalAlignment="Left"
                  Command="{Binding RunCommand}"
                  Style="{StaticResource Button.Primary}"
                  ToolTip="Optimization is not available in this phase."
                  ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <TextBlock Text="{Binding SafetyNote}" Style="{StaticResource Text.Caption}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</views:PageView>
