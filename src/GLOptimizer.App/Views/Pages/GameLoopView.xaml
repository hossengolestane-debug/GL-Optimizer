<views:PageView x:Class="GLOptimizer.App.Views.Pages.GameLoopView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                xmlns:controls="clr-namespace:GLOptimizer.App.Controls"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
          <Button Content="Cancel" Command="{Binding CancelScanCommand}" Style="{StaticResource Button.Secondary}" />
        </WrapPanel>
      </Grid>

      <TextBlock Text="No verified GameLoop install was found." Style="{StaticResource Text.Subtitle}" Margin="0,20,0,0"
                 Visibility="{Binding HasInstalls, Converter={StaticResource InverseBoolToVis}}" />
      <ListBox ItemsSource="{Binding Installs}" SelectedItem="{Binding SelectedInstall}" Margin="0,16,0,0"
               Visibility="{Binding HasInstalls, Converter={StaticResource BoolToVis}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4">
              <TextBlock Text="{Binding Path}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                <Run Text="  ·  Engine " /><Run Text="{Binding Engine, Mode=OneWay}" />
                <Run Text="  ·  " /><Run Text="{Binding Status, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Processes" Style="{StaticResource Text.Section}" />
          <TextBlock Text="No GameLoop process was tied to the selected install." Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0"
                     Visibility="{Binding HasProcesses, Converter={StaticResource InverseBoolToVis}}" />
          <ItemsControl ItemsSource="{Binding Processes}" Margin="0,8,0,0" Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                  <Run Text="{Binding Pid, Mode=OneWay}" />
                  <Run Text="  " />
                  <Run Text="{Binding Name, Mode=OneWay}" />
                  <Run Text="  " />
                  <Run Text="{Binding Path, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Start" Command="{Binding StartCommand}" Margin="0,0,8,8" Style="{StaticResource Button.Secondary}" />
            <Button Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,8,8" Style="{StaticResource Button.Secondary}" />
            <Button Content="Close" Command="{Binding CloseCommand}" Margin="0,0,8,8" Style="{StaticResource Button.Secondary}" />
            <Button Content="Launch Optimized" Command="{Binding LaunchOptimizedCommand}" Margin="0,0,8,8" Style="{StaticResource Button.Primary}" />
          </WrapPanel>
          <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RuntimeNote}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Configuration" Style="{StaticResource Text.Section}" />
          <TextBlock Text="{Binding ConfigNotice}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ConfigSettings}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:DiagnosticRow Title="{Binding Title}" Detail="{Binding Detail}" BadgeText="{Binding BadgeText}" Kind="{Binding BadgeKind}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No configuration locations were checked." Style="{StaticResource Text.Subtitle}" Margin="0,12,0,0"
                     Visibility="{Binding HasConfigFiles, Converter={StaticResource InverseBoolToVis}}" />
          <ItemsControl ItemsSource="{Binding ConfigFiles}" Margin="0,8,0,0" Visibility="{Binding HasConfigFiles, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:DiagnosticRow Title="{Binding Title}" Detail="{Binding Detail}" BadgeText="{Binding BadgeText}" Kind="{Binding BadgeKind}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasSharedConfig, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="User configuration" Style="{StaticResource Text.Section}" />
          <TextBlock Text="{Binding SharedNotice}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding SharedSettings}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:DiagnosticRow Title="{Binding Title}" Detail="{Binding Detail}" BadgeText="{Binding BadgeText}" Kind="{Binding BadgeKind}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding SharedFiles}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:DiagnosticRow Title="{Binding Title}" Detail="{Binding Detail}" BadgeText="{Binding BadgeText}" Kind="{Binding BadgeKind}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <TextBlock Text="{Binding SafetyNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</views:PageView>
