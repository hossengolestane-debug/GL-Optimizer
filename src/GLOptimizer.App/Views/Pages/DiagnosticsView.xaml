<views:PageView x:Class="GLOptimizer.App.Views.Pages.DiagnosticsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                xmlns:controls="clr-namespace:GLOptimizer.App.Controls"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Run checks" Command="{Binding RunChecksCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
          <Button Content="Cancel" Command="{Binding CancelScanCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
          <Button Content="Export TXT" Command="{Binding ExportTextCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
          <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
          <Button Content="Copy Report" Command="{Binding CopyReportCommand}" Margin="0,0,8,8" Style="{StaticResource Button.Secondary}" />
        </WrapPanel>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,20,0,0">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:DiagnosticRow Title="{Binding Title}" Detail="{Binding Detail}" BadgeText="{Binding BadgeText}" Kind="{Binding BadgeKind}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Network" Style="{StaticResource Text.Section}" />
          <TextBlock Text="{Binding NetworkSummary}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <Button Content="Run" Command="{Binding RunNetworkCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding ExportMessage}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <TextBlock Text="{Binding SafetyNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</views:PageView>
