<views:PageView x:Class="GLOptimizer.App.Views.Pages.AppMarketView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                xmlns:controls="clr-namespace:GLOptimizer.App.Controls"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,20" />
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding ShowToast, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding Toast}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="App Market" Style="{StaticResource Text.Section}" />
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,12,0,0" TextWrapping="Wrap">
            <Run Text="Status" />
            <Run Text="  " />
            <Run Text="{Binding StatusText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap">
            <Run Text="Installed" />
            <Run Text="  " />
            <Run Text="{Binding InstalledVersion, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap">
            <Run Text="Market" />
            <Run Text="  " />
            <Run Text="{Binding MarketVersion, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap">
            <Run Text="Official" />
            <Run Text="  " />
            <Run Text="{Binding OfficialVersion, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="{Binding OfficialDetail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap">
            <Run Text="Last scan" />
            <Run Text="  " />
            <Run Text="{Binding LastScan, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="Detected issue" Style="{StaticResource Text.Section}" Margin="0,16,0,0" />
          <TextBlock Text="{Binding Issue}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RepairMessage}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="CHECK AGAIN" Command="{Binding CheckAgainCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Primary}" />
            <Button Content="DRY RUN REPAIR" Command="{Binding DryRunCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
            <Button Content="REPAIR APP MARKET" Command="{Binding RepairCommand}" Style="{StaticResource Button.Secondary}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="START GAMELOOP" Command="{Binding StartGameLoopCommand}" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
            <Button Content="RE-CHECK AFTER GAMELOOP REFRESH" Command="{Binding RecheckCommand}" Style="{StaticResource Button.Secondary}" />
          </StackPanel>
          <Expander Header="What will be changed?" Margin="0,16,0,0">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="{Binding RepairNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DryRunText}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding PlannedChanges}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding RepairTargets}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                      <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                        <Run Text="{Binding Kind, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Confidence, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Size, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Written, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRepairing, Converter={StaticResource BoolToVis}}">
        <controls:ProgressPanel Title="App Market repair" Message="{Binding ProgressMessage}" Progress="{Binding Progress}" />
        <Button Content="CANCEL" Command="{Binding CancelRepairCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" />
      </StackPanel>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <TextBlock Text="{Binding SafetyNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</views:PageView>
