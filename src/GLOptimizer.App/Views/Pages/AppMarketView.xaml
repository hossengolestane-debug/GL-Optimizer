<views:PageView x:Class="GLOptimizer.App.Views.Pages.AppMarketView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,20" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Diagnostics" Style="{StaticResource Text.Section}" />
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <TextBlock Text="{Binding SafetyNote}" Style="{StaticResource Text.Caption}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</views:PageView>
