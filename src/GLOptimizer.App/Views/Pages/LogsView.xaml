<views:PageView x:Class="GLOptimizer.App.Views.Pages.LogsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                xmlns:controls="clr-namespace:GLOptimizer.App.Controls"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding LogPath}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogPath}" />
        <DockPanel Margin="0,16,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Refresh" Command="{Binding ReloadCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
            <Button Content="Open folder" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,0,8" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource Button.Choice}"
                        Command="{Binding DataContext.SelectLevelCommand, RelativeSource={RelativeSource AncestorType=views:PageView}}"
                        CommandParameter="{Binding Level}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
      </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="No log entries match this filter." Style="{StaticResource Text.Subtitle}" Margin="0,12,0,0"
                 Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}" />
      <ListBox ItemsSource="{Binding Entries}" Margin="0,8,0,0" Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" />
              <controls:StatusBadge Grid.Column="1" Text="{Binding Severity}" Kind="{Binding Kind}" VerticalAlignment="Top" />
              <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock>
                  <Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text="  " />
                  <Run Text="{Binding Message, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Exception}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </ScrollViewer>
</views:PageView>
