<views:PageView x:Class="GLOptimizer.App.Views.Pages.ActivityView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" />
        <Button Content="Refresh" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Margin="0,16,0,8" Style="{StaticResource Button.Secondary}" />
      </StackPanel>
      <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Details" Style="{StaticResource Text.Section}" />
          <TextBlock Text="{Binding SelectedTime}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding SelectedTitle}" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock DockPanel.Dock="Top" Text="No activity has been recorded yet." Style="{StaticResource Text.Subtitle}" Margin="0,12,0,0"
                 Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}" />
      <ListBox ItemsSource="{Binding Entries}" Margin="0,8,0,0" Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=views:PageView}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource Button.Secondary}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </ScrollViewer>
</views:PageView>
