<views:PageView x:Class="GLOptimizer.App.Views.Pages.SettingsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:GLOptimizer.App.Views"
                xmlns:controls="clr-namespace:GLOptimizer.App.Controls"
                Background="Transparent">
  <ScrollViewer Style="{StaticResource Scroll.Page}">
    <StackPanel MaxWidth="920" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,8,0,20" />

      <controls:SettingsRow Title="Theme" Description="{Binding ThemeNote}">
        <controls:SettingsRow.Slot>
          <TextBlock Text="Dark" VerticalAlignment="Center" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Start with Windows" Description="{Binding StartupNote}">
        <controls:SettingsRow.Slot>
          <CheckBox IsChecked="{Binding StartWithWindows}" Content="Enabled" VerticalAlignment="Center" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Minimize to tray" Description="Minimizing or closing hides the window. Exit from the tray quits.">
        <controls:SettingsRow.Slot>
          <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Enabled" VerticalAlignment="Center" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Monitoring" Description="When this is off, the dashboard and Monitoring page do not sample.">
        <controls:SettingsRow.Slot>
          <CheckBox IsChecked="{Binding MonitoringEnabled}" Content="Enabled" VerticalAlignment="Center" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Automatic backup" Description="After saving, copy discovered GameLoop configuration when files exist.">
        <controls:SettingsRow.Slot>
          <CheckBox IsChecked="{Binding AutomaticBackup}" Content="Enabled" VerticalAlignment="Center" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="GameLoop path" Description="Used only after a known launcher file is found in that folder.">
        <controls:SettingsRow.Slot>
          <TextBox MinWidth="160" MaxWidth="420" Text="{Binding GameLoopPathOverride, UpdateSourceTrigger=PropertyChanged}" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Appearance" Description="The interface stays black and white.">
        <controls:SettingsRow.Slot>
          <TextBlock Text="{Binding Appearance}" VerticalAlignment="Center" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Minimum log level" Description="Entries below this level are not written.">
        <controls:SettingsRow.Slot>
          <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel MaxWidth="360" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource Button.Choice}"
                        Command="{Binding DataContext.SelectLevelCommand, RelativeSource={RelativeSource AncestorType=views:PageView}}"
                        CommandParameter="{Binding Level}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Log retention" Description="Archived logs older than this many days are deleted. Range 1–90.">
        <controls:SettingsRow.Slot>
          <TextBox Width="88" Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Sample interval" Description="How often live monitoring reads CPU, memory, disk, and GameLoop. 500, 1000, or 2000 ms.">
        <controls:SettingsRow.Slot>
          <WrapPanel Orientation="Horizontal">
            <Button Content="0.5 s" Command="{Binding SelectIntervalCommand}" CommandParameter="500" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
            <Button Content="1 s" Command="{Binding SelectIntervalCommand}" CommandParameter="1000" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" />
            <Button Content="2 s" Command="{Binding SelectIntervalCommand}" CommandParameter="2000" Margin="0,0,0,8" Style="{StaticResource Button.Secondary}" />
          </WrapPanel>
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <controls:SettingsRow Title="Log file size" Description="Active log size in megabytes before rotation. Range 1–50.">
        <controls:SettingsRow.Slot>
          <TextBox Width="88" Text="{Binding MaxLogMegabytesText, UpdateSourceTrigger=PropertyChanged}" />
        </controls:SettingsRow.Slot>
      </controls:SettingsRow>

      <WrapPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" />
        <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,8,0,0" TextWrapping="Wrap" />
      </WrapPanel>

      <StackPanel Margin="0,28,0,0" Visibility="{Binding ShowDeveloperTools, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Developer" Style="{StaticResource Text.Section}" />
        <TextBlock Text="Shown only in debug builds." Style="{StaticResource Text.Caption}" Margin="0,6,0,12" />
        <TextBlock Text="{Binding PathsSummary}" Style="{StaticResource Text.Caption}" Margin="0,0,0,12" />
        <CheckBox IsChecked="{Binding DeveloperSimulation}" Content="Simulate GameLoop, COD versions, App Market state, and a CPU sample" Margin="0,0,0,12" />
        <Button Content="Write debug log entry" Command="{Binding WriteDeveloperLogCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</views:PageView>
