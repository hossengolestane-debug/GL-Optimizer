<Window x:Class="GLOptimizer.App.Views.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GL Optimizer"
        Width="480"
        SizeToContent="Height"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface.1}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">
  <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="24">
    <StackPanel>
      <TextBlock Text="Something went wrong" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Subtitle}" Margin="0,10,0,0" />
      <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Copy detail" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Click="CopyClick" />
        <Button Content="Close" Style="{StaticResource Button.Primary}" MinWidth="96" Click="CloseClick" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
