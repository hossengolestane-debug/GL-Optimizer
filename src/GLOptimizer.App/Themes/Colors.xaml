<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Background">#FF0A0A0A</Color>
  <Color x:Key="Color.Surface.1">#FF111111</Color>
  <Color x:Key="Color.Surface.2">#FF171717</Color>
  <Color x:Key="Color.Surface.3">#FF202020</Color>
  <Color x:Key="Color.Text.Primary">#FFFFFFFF</Color>
  <Color x:Key="Color.Text.Secondary">#FFA0A0A0</Color>
  <Color x:Key="Color.Border">#FF292929</Color>
  <Color x:Key="Color.Hover">#FF262626</Color>
  <Color x:Key="Color.Pressed">#FF2C2C2C</Color>
  <Color x:Key="Color.Primary.Hover">#FFE8E8E8</Color>
  <Color x:Key="Color.Primary.Pressed">#FFD0D0D0</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface.1" Color="{StaticResource Color.Surface.1}" />
  <SolidColorBrush x:Key="Brush.Surface.2" Color="{StaticResource Color.Surface.2}" />
  <SolidColorBrush x:Key="Brush.Surface.3" Color="{StaticResource Color.Surface.3}" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />

  <CornerRadius x:Key="Radius.Control">8</CornerRadius>
  <CornerRadius x:Key="Radius.Card">12</CornerRadius>
</ResourceDictionary>
